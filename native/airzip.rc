#include <windows.h>
#include "resource.h"

// Manifest: asInvoker + common controls v6 + per-monitor DPI.
1 RT_MANIFEST "airzip.manifest"

IDI_APPICON  ICON    "..\\icon.ico"

// The 7-Zip engine rides inside the exe and is unpacked to %TEMP%\AirZip on
// first run. Stored raw; the bundle is already small enough that compressing
// it would only buy ~1 MB at the cost of a build-time packer.
IDR_SEVENZIP RCDATA  "..\\7z.dll"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "AirZip"
      VALUE "FileVersion",     "1.0.0.0"
      VALUE "InternalName",    "AirZip"
      VALUE "OriginalFilename","AirZip.exe"
      VALUE "ProductName",     "AirZip"
      VALUE "ProductVersion",  "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
